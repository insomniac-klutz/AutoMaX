          "type": "array"
        },
        "calib_independent_n": {
          "title": "Calib Independent N",
          "type": "integer"
        },
        "calib_n": {
          "title": "Calib N",
          "type": "integer"
        },
        "call_policy": {
          "$ref": "#/$defs/CallPolicy",
          "default": "single"
        },
        "cert_mode": {
          "const": "fixed_sequence",
          "default": "fixed_sequence",
          "title": "Cert Mode",
          "type": "string"
        },
        "certify_calls_max": {
          "title": "Certify Calls Max",
          "type": "integer"
        },
        "certify_calls_used": {
          "title": "Certify Calls Used",
          "type": "integer"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "delta_per_band": {
          "title": "Delta Per Band",
          "type": "number"
        },
        "estimand": {
          "enum": [
            "unit_weighted",
            "group_weighted"
          ],
          "title": "Estimand",
          "type": "string"
        },
        "grid_hash": {
          "title": "Grid Hash",
          "type": "string"
        },
        "p_value_family": {
          "enum": [
            "binomial",
            "hoeffding_bentkus"
          ],
          "title": "P Value Family",
          "type": "string"
        },
        "regime": {
          "$ref": "#/$defs/Regime"
        },
        "sealed_n": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sealed N"
        },
        "simultaneous_level": {
          "title": "Simultaneous Level",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/GuaranteeType"
        }
      },
      "required": [
        "type",
        "delta",
        "delta_per_band",
        "simultaneous_level",
        "regime",
        "estimand",
        "p_value_family",
        "certify_calls_used",
        "certify_calls_max",
        "calib_n",
        "calib_independent_n",
        "grid_hash",
        "assumptions"
      ],
      "title": "Guarantee",
      "type": "object"
    },
    "GuaranteeType": {
      "enum": [
        "pac_high_prob",
        "expectation",
        "long_run_frequency",
        "holdout_empirical",
        "none"
      ],
      "title": "GuaranteeType",
      "type": "string"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "ci95": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci95"
        },
        "est": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Est"
        },
        "method": {
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "est",
        "ci95",
        "method"
      ],
      "title": "Interval",
      "type": "object"
    },
    "Policy": {
      "enum": [
        "auto",
        "audit"
      ],
      "title": "Policy",
      "type": "string"
    },
    "Regime": {
      "enum": [
        "auto",
        "iid",
        "grouped",
        "temporal",
        "blocked"
      ],
      "title": "Regime",
      "type": "string"
    },
    "RiskEstimate": {
      "additionalProperties": false,
      "properties": {
        "bound": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bound"
        },
        "est": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Est"
        },
        "upper95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper95"
        }
      },
      "required": [
        "est"
      ],
      "title": "RiskEstimate",
      "type": "object"
    },
    "SliceEntry": {
      "additionalProperties": false,
      "properties": {
        "bound": {
          "title": "Bound",
          "type": "string"
        },
        "flag": {
          "anyOf": [
            {
              "enum": [
                "insufficient_n",
                "upper_gt_2alpha"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Flag"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "risk": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk"
        },
        "slice": {
          "title": "Slice",
          "type": "string"
        },
        "upper95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper95"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "slice",
        "value",
        "n",
        "risk",
        "upper95",
        "bound",
        "flag"
      ],
      "title": "SliceEntry",
      "type": "object"
    },
