      "title": "BandEntry",
      "type": "object"
    },
    "BandStatus": {
      "enum": [
        "certified",
        "inherited",
        "uncertified"
      ],
      "title": "BandStatus",
      "type": "string"
    },
    "CallPolicy": {
      "description": "How certify calls share the failure budget (OQ Q1).",
      "enum": [
        "single",
        "preregistered",
        "sliced"
      ],
      "title": "CallPolicy",
      "type": "string"
    },
    "FrontierPoint": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "title": "Coverage",
          "type": "number"
        },
        "risk": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk"
        },
        "tau": {
          "title": "Tau",
          "type": "number"
        }
      },
      "required": [
        "tau",
        "coverage",
        "risk"
      ],
      "title": "FrontierPoint",
      "type": "object"
    },
    "Guarantee": {
      "additionalProperties": false,
