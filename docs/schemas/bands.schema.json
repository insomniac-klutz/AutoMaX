        "source_band": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Band"
        },
        "start_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Index"
        },
        "status": {
          "$ref": "#/$defs/BandStatus"
        },
        "stop_reason": {
          "$ref": "#/$defs/StopReason"
        },
        "tau_hat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tau Hat"
        },
        "tau_hat_raw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
