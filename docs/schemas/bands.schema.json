      "enum": [
        "end_of_grid",
        "risk_limited",
        "sample_size_limited",
        "infeasible_on_dev"
      ],
      "title": "StopReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "amx_version": {
      "title": "Amx Version",
      "type": "string"
    },
    "artifact_hash": {
      "title": "Artifact Hash",
      "type": "string"
    },
    "bands": {
      "items": {
        "$ref": "#/$defs/BandEntry"
      },
      "title": "Bands",
      "type": "array"
    },
    "diagnostics": {
      "additionalProperties": true,
      "default": {},
      "title": "Diagnostics",
      "type": "object"
    },
    "frontier_descriptive": {
      "items": {
        "$ref": "#/$defs/FrontierPoint"
      },
      "title": "Frontier Descriptive",
      "type": "array"
    },
    "guarantee": {
      "$ref": "#/$defs/Guarantee"
    },
    "never_claimed": {
      "items": {
        "type": "string"
      },
      "title": "Never Claimed",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "taskspec_hash": {
      "title": "Taskspec Hash",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "amx_version",
    "run_id",
    "taskspec_hash",
    "artifact_hash",
    "guarantee",
    "bands",
    "frontier_descriptive",
    "warnings",
    "never_claimed"
  ],
  "title": "Certificate",
  "type": "object"
}
