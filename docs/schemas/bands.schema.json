      "required": [
        "alpha",
        "policy",
        "delta_j",
        "status",
        "tau_hat",
        "tau_hat_raw",
        "source_band",
        "stop_reason",
        "n_min_required",
        "start_index",
        "tests_run",
        "p_value_raw",
        "n_committed_calib",
        "n_independent_calib",
        "coverage_at_certified_tau",
        "risk_calib",
        "risk_calib_unit_weighted"
