          "$ref": "#/$defs/Interval"
        },
        "coverage_sealed": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "delta_j": {
          "title": "Delta J",
          "type": "number"
        },
        "n_committed_calib": {
          "title": "N Committed Calib",
          "type": "integer"
        },
        "n_independent_calib": {
          "title": "N Independent Calib",
          "type": "integer"
        },
        "n_min_required": {
          "title": "N Min Required",
          "type": "integer"
        },
        "p_value_raw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
